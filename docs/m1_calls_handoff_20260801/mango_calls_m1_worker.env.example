# Значения не хранить в Git. Итоговый файл: $HOME/.mango_secrets/mango_calls_m1_worker.env, mode 0600.
MANGO_OFFICE_BASE_URL=https://app.mango-office.ru
MANGO_OFFICE_API_KEY=
MANGO_OFFICE_API_SALT=
MANGO_CALLS_EXPECTED_CODE_SHA=<EXPECTED_CODE_SHA>
MANGO_CALLS_PIPELINE_ROOT=<HOME>/.mango_local/mango_calls_two_processes
MANGO_CALLS_MANGO_ENV=<HOME>/.mango_secrets/mango_office.env
MANGO_CALLS_TALLANTO_ENV=<HOME>/.mango_secrets/tallanto_readonly.env
MANGO_CALLS_TALLANTO_EXPORT=<HOME>/.mango_local/tallanto/Contacts_current.csv
MANGO_CALLS_TALLANTO_SNAPSHOT_AS_OF=<CURRENT_TALLANTO_SNAPSHOT_ISO8601>

# Phase A намеренно не содержит Google/Yandex write-параметров. Они добавляются
# только в отдельный owner-only файл после явного допуска внешней записи.
