<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>EnvironmentVariables</key>
  <dict>
    <key>CUSTOMER_TIMELINE_NIGHTLY_HOME</key>
    <string>__CUSTOMER_TIMELINE_NIGHTLY_HOME__</string>
    <key>TALLANTO_API_CAPTURE_ENABLED</key>
    <string>1</string>
  </dict>
  <key>Label</key>
  <string>com.mango.customer-timeline-tallanto-api-capture</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>__MANGO_CODE_ROOT__/scripts/run_customer_timeline_codex_task.py</string>
    <string>--task</string>
    <string>tallanto-api-capture</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__MANGO_CODE_ROOT__</string>
  <key>StandardOutPath</key>
  <string>__CUSTOMER_TIMELINE_NIGHTLY_HOME__/.codex_local/staging/daily_capture/tallanto_api_capture.launchd.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>__CUSTOMER_TIMELINE_NIGHTLY_HOME__/.codex_local/staging/daily_capture/tallanto_api_capture.launchd.stderr.log</string>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>2</integer>
    <key>Minute</key>
    <integer>40</integer>
  </dict>
  <key>RunAtLoad</key>
  <false/>
  <key>KeepAlive</key>
  <false/>
  <key>ThrottleInterval</key>
  <integer>3600</integer>
</dict>
</plist>
