<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- DEPRECATED: do not install. Replaced by the download/process/import chain. -->
<dict>
  <key>Disabled</key>
  <true/>
  <key>Label</key>
  <string>com.mango.customer-timeline-mail-capture</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/false</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/tmp</string>
  <key>StandardOutPath</key>
  <string>/tmp/com.mango.customer-timeline-mail-capture.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/com.mango.customer-timeline-mail-capture.stderr.log</string>
  <key>RunAtLoad</key>
  <false/>
  <key>KeepAlive</key>
  <false/>
  <key>ThrottleInterval</key>
  <integer>3600</integer>
</dict>
</plist>
